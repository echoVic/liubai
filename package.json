{
  "name": "liubai",
  "private": true,
  "version": "0.7.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "check:headless": "tsc --noEmit && tsc --noEmit -p scripts && node scripts/check-i18n.mjs && node scripts/check-themes.mjs && for check in scripts/check-*.ts; do [ $check = scripts/check-performance.ts ] || bun $check || exit 1; done"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.4.3",
    "docx": "9.8.1",
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "12.1.0",
    "mygo-runtime": "0.9.0",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/turndown": "5.0.5",
    "esbuild": "^0.25.0",
    "jszip": "^3.10.2",
    "typescript": "^5.8.3"
  }
}
